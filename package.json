{
  "name": "breakdown",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && pnpm --filter @breakdown/web dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @breakdown/db db:generate",
    "db:migrate": "pnpm --filter @breakdown/db db:migrate",
    "db:seed": "pnpm --filter @breakdown/core db:seed",
    "ingest:github": "pnpm --filter @breakdown/core ingest:github",
    "ingest:beads": "INGEST_BEADS_CWD=\"$INIT_CWD\" pnpm --filter @breakdown/core ingest:beads",
    "ingest:repo": "INGEST_REPO_CWD=\"$INIT_CWD\" pnpm --filter @breakdown/core ingest:repo",
    "client-token": "pnpm -s --filter @breakdown/core client-token",
    "mcp:serve": "pnpm --filter @breakdown/mcp serve",
    "mcp:service": "node bin/mcp-service.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run && node --test bin/*.test.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
