#!/usr/bin/env node
// inbox-watch — makes a decision in the inbox act right away. Polls the
// local breakdown server and, when you've accepted (or sent back) an item
// that no live session owns, runs your own Claude Code headless in this
// checkout to carry it out:
//
//   accepted → `claude -p` with the inbox-execute skill (does the action, marks it done)
//   changes  → `claude -p` with inbox-execute's Triage: close, act, or re-queue on the note
//
// Items a live session owns (queued with `inbox request`, or opened with
// "Open session") are skipped: the server already prompted that session.
// So are items a remote hangar session filed (`hangarSession`): the
// decision went to that session's messages.
//
// This runs outside the app on purpose. breakdown never calls a model; this
// is a convenience loop on your machine that starts the Claude Code you
// already use, with your connectors, the same as typing the skill yourself.
// Each run uses --permission-mode bypassPermissions, so it acts without
// asking — the approval was your Accept. Stop it with Ctrl-C.
//
//   inbox-watch [--interval 30] [--once] [--dry-run] [--max-age 24h] [--allow-remote]
//
// It polls only a loopback Breakdown (127.0.0.0/8, ::1, localhost) unless
// given --allow-remote, and then only over https, or http to a tailnet
// address or *.ts.net name (the relay's --url rule); redirects are never
// followed. Each run is named exactly the item ids this script selected,
// never the server's text, and acts on no other item. An item whose
// decision (its latest matching feedback entry's `at`, else `updatedAt`)
// is older than --max-age is skipped. Against a remote Breakdown the run
// is denied shell and file-edit tools, but it still acts through your
// connectors on content that server wrote: read
// docs/relay.md#what-the-relay-trusts before using --allow-remote. The
// checks live in bin/inbox-watch-lib.mjs.
//
// $BREAKDOWN_API points it at another server (default the local one). When
// $BREAKDOWN_TOKEN is set, each poll sends it as `Authorization: Bearer`
// (needed off loopback; an `agent` token may read the inbox). They resolve
// as bin/inbox and bin/review-request resolve them: an empty value is
// unset, a trailing slash is dropped, and a URL that is not http(s) is
// refused. Both are this script's variables, not the server's.

import { spawn } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  buildPrompt,
  checkApiTrust,
  claudeArgs,
  itemKey,
  MAX_IDS_PER_RUN,
  parseInboxResponse,
  parseWatchArgs,
  remoteWarning,
  resolveApi,
  sanitizeForLog,
  selectDue,
  WATCH_USAGE,
  WATCHED_STATUSES,
} from "./inbox-watch-lib.mjs";

const options = parseWatchArgs(process.argv.slice(2));
if ("help" in options) {
  console.log(WATCH_USAGE);
  process.exit(0);
}
if ("error" in options) {
  console.error(`inbox-watch: ${options.error}\n${WATCH_USAGE}`);
  process.exit(2);
}

const resolved = resolveApi(process.env);
if ("error" in resolved) {
  console.error(`inbox-watch: ${resolved.error}`);
  process.exit(2);
}
const API = resolved.api;
const trust = checkApiTrust(API, { allowRemote: options.allowRemote });
if ("error" in trust) {
  console.error(`inbox-watch: ${trust.error}`);
  process.exit(2);
}
const REMOTE = trust.remote;

const AUTH = process.env.BREAKDOWN_TOKEN ? { authorization: `Bearer ${process.env.BREAKDOWN_TOKEN}` } : {};
const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

if (REMOTE) console.error(remoteWarning(API, REPO, options.maxAge, { hasToken: Boolean(process.env.BREAKDOWN_TOKEN) }));

function log(message) {
  console.log(`[${new Date().toLocaleTimeString()}] ${message}`);
}

async function query(statuses) {
  const url = `${API}/trpc/inbox?input=${encodeURIComponent(JSON.stringify({ statuses }))}`;
  const res = await fetch(url, { headers: AUTH, redirect: "error" });
  const text = await res.text();
  let body;
  try {
    body = JSON.parse(text);
  } catch {
    throw new Error(`HTTP ${res.status}, not JSON`);
  }
  if (!res.ok || body?.error) throw new Error(typeof body?.error?.message === "string" ? body.error.message : `HTTP ${res.status}`);
  const parsed = parseInboxResponse(body);
  if ("error" in parsed) throw new Error(parsed.error);
  if (parsed.dropped > 0) log(`dropped ${parsed.dropped} malformed inbox entr${parsed.dropped === 1 ? "y" : "ies"}`);
  return parsed.items;
}

function runClaude(args) {
  return new Promise((resolve) => {
    const child = spawn("claude", args, { cwd: REPO, stdio: ["ignore", "inherit", "inherit"] });
    child.on("error", (err) => {
      log(`could not start claude: ${err.message}`);
      resolve(1);
    });
    child.on("exit", (code) => resolve(code ?? 1));
  });
}

// An item is tried once per version: if the run leaves it untouched (a
// connector failed, say), it isn't retried until something changes it. A
// skipped stale item is logged once per version the same way.
const tried = new Set();

async function tick() {
  let items;
  try {
    items = await query(WATCHED_STATUSES);
  } catch (err) {
    const reason = sanitizeForLog(err instanceof Error ? err.message : String(err));
    log(`can't read the inbox (${reason})${REMOTE ? "" : "; is `pnpm dev` running?"}`);
    return;
  }
  for (const status of WATCHED_STATUSES) {
    const { due, stale } = selectDue(items, { status, now: Date.now(), maxAgeMs: options.maxAgeMs, maxAge: options.maxAge, tried });
    for (const { item, reason } of stale) {
      log(`skipped ${item.id} (${status}): ${reason}`);
      tried.add(itemKey(item));
    }
    if (due.length === 0) continue;
    const batch = due.slice(0, MAX_IDS_PER_RUN);
    for (const item of batch) tried.add(itemKey(item));
    const ids = batch.map((item) => item.id);
    log(`${batch.length} ${status}: ${ids.join(", ")}`);
    if (options.dryRun) {
      log(`dry run: would run claude on ${status} ${ids.join(", ")}`);
      continue;
    }
    const code = await runClaude(claudeArgs(buildPrompt(status, ids), { remote: REMOTE }));
    log(code === 0 ? `${status} run finished` : `${status} run exited ${code}`);
  }
}

log(`watching ${API} every ${options.intervalMs / 1000}s, max-age ${options.maxAge}, ${REMOTE ? "REMOTE" : "loopback"} (repo ${REPO})${options.dryRun ? " — dry run" : ""}`);
for (;;) {
  await tick();
  if (options.once) break;
  await new Promise((r) => setTimeout(r, options.intervalMs));
}
