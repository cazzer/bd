#!/usr/bin/env node
// inbox-watch — makes a decision in the inbox act right away. Polls the
// local breakdown server and, when you've accepted (or sent back) an item
// that no live session owns, runs your own Claude Code headless in this
// checkout to carry it out:
//
//   accepted → `claude -p` with the inbox-execute skill (does the action, marks it done)
//   changes  → `claude -p` with inbox-execute's Triage: close, act, or re-queue on the note
//
// Items a live session owns (queued with `inbox request`, or opened with
// "Open session") are skipped: the server already prompted that session.
//
// This runs outside the app on purpose. breakdown never calls a model; this
// is a convenience loop on your machine that starts the Claude Code you
// already use, with your connectors, the same as typing the skill yourself.
// Each run uses --permission-mode bypassPermissions, so it acts without
// asking — the approval was your Accept. Stop it with Ctrl-C.
//
//   inbox-watch [--interval 30] [--once] [--dry-run]
//
// $BREAKDOWN_API points it at another server (default the local one). When
// $BREAKDOWN_TOKEN is set, each poll sends it as `Authorization: Bearer`
// (needed off loopback; an `agent` token may read the inbox). Both are this
// script's variables, not the server's.

import { spawn } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { parseArgs } from "node:util";

const API = process.env.BREAKDOWN_API ?? `http://127.0.0.1:${process.env.WEB_SERVER_PORT ?? "4310"}`;
const AUTH = process.env.BREAKDOWN_TOKEN ? { authorization: `Bearer ${process.env.BREAKDOWN_TOKEN}` } : {};
const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

const { values } = parseArgs({
  options: {
    interval: { type: "string", default: "30" },
    once: { type: "boolean", default: false },
    "dry-run": { type: "boolean", default: false },
  },
});
const intervalMs = Math.max(10, Number(values.interval)) * 1000;

const PROMPTS = {
  accepted:
    "Use the inbox-execute skill: carry out every accepted inbox item that has no `pane`, exactly as accepted (the chosen card option when there is one, and any accept note), then mark each done. Report one line per item.",
  changes:
    "Use the inbox-execute skill's Triage section: for every inbox item with status `changes` that has no `pane`, read its latest feedback and close it, act on it, or re-queue it, exactly as the section says. Don't pull any sources. Report one line per item: the outcome and why.",
};

function log(message) {
  console.log(`[${new Date().toLocaleTimeString()}] ${message}`);
}

async function query(statuses) {
  const url = `${API}/trpc/inbox?input=${encodeURIComponent(JSON.stringify({ statuses }))}`;
  const res = await fetch(url, { headers: AUTH });
  const body = await res.json();
  if (!res.ok || body?.error) throw new Error(body?.error?.message ?? `HTTP ${res.status}`);
  return body.result.data.items;
}

function runClaude(prompt) {
  return new Promise((resolve) => {
    const child = spawn("claude", ["-p", prompt, "--mcp-config", ".mcp.json", "--permission-mode", "bypassPermissions"], { cwd: REPO, stdio: ["ignore", "inherit", "inherit"] });
    child.on("error", (err) => {
      log(`could not start claude: ${err.message}`);
      resolve(1);
    });
    child.on("exit", (code) => resolve(code ?? 1));
  });
}

// An item is tried once per version: if the run leaves it untouched (a
// connector failed, say), it isn't retried until something changes it.
const tried = new Set();

async function tick() {
  let items;
  try {
    items = await query(["accepted", "changes"]);
  } catch (err) {
    log(`can't read the inbox (${err.message}); is \`pnpm dev\` running?`);
    return;
  }
  for (const status of ["accepted", "changes"]) {
    const due = items.filter((i) => i.status === status && i.pane === null && !tried.has(`${i.id}@${i.updatedAt}`));
    if (due.length === 0) continue;
    log(`${due.length} ${status}: ${due.map((i) => i.title).join(" · ")}`);
    for (const i of due) tried.add(`${i.id}@${i.updatedAt}`);
    if (values["dry-run"]) continue;
    const code = await runClaude(PROMPTS[status]);
    log(code === 0 ? `${status} run finished` : `${status} run exited ${code}`);
  }
}

log(`watching ${API} every ${intervalMs / 1000}s (repo ${REPO})${values["dry-run"] ? " — dry run" : ""}`);
for (;;) {
  await tick();
  if (values.once) break;
  await new Promise((r) => setTimeout(r, intervalMs));
}
