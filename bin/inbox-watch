#!/usr/bin/env node
// inbox-watch — makes a decision in the inbox act right away. Polls a
// breakdown server's inbox and, when you've accepted (or sent back) an item
// that no live session owns, runs your own Claude Code headless in this
// checkout to carry it out:
//
//   accepted → `claude -p` with the inbox-execute skill (does the action, marks it done)
//   changes  → `claude -p` with inbox-execute's Triage: close, act, or re-queue on the note
//
// Items a live session owns (queued with `inbox request`, or opened with
// "Open session") are skipped: the server already prompted that session.
// So are items a remote hangar session filed (`hangarSession`): the
// decision went to that session's messages.
//
// This runs outside the app on purpose. breakdown never calls a model; this
// is a convenience loop on your machine that starts the Claude Code you
// already use. Each run uses --permission-mode bypassPermissions, so it
// acts without asking — the approval was your Accept. Stop it with Ctrl-C.
//
//   inbox-watch [--interval 30] [--once] [--dry-run] [--max-age 24h]
//               [--max-runs-per-hour 12] [--allow-remote]
//
// Two modes. By default it polls only a loopback BREAKDOWN_API (127.0.0.0/8,
// ::1, localhost: a hostname check, so an ssh tunnel or local proxy passes
// too). With --allow-remote it polls another host, but only over https, or
// http to a tailnet address or *.ts.net name (the relay's --url rule), and
// warns when it starts. Either way, redirects are never followed; each run
// is named exactly the item ids this script selected, never the server's
// text, and told to act on no other item; an item whose decision (its
// latest matching feedback entry's `at`, else `updatedAt`) is older than
// --max-age is skipped; past --max-runs-per-hour runs the watcher stops;
// and each run gets no built-in tools except Skill and ToolSearch, so no
// built-in tool runs commands, reads or writes files, fetches the web, or
// starts subagents. But every MCP server your Claude config loads stays
// available, and a local one (a plugin's stdio server, say) can do whatever
// it does, including install software or write files; hooks from your
// settings and plugins still run. Until bd-d38.18 binds the run to a strict
// MCP config, don't use --allow-remote against a Breakdown you wouldn't let
// drive every MCP server your Claude config loads. The item content a run
// acts on comes from the `brain` MCP entry in your Claude config, not from
// BREAKDOWN_API, so either mode is only as trustworthy as that entry: read
// docs/relay.md#what-the-relay-trusts before using --allow-remote. The
// checks live in bin/inbox-watch-lib.mjs.
//
// $BREAKDOWN_API points it at another server (default the local one). When
// $BREAKDOWN_TOKEN is set, each poll sends it as `Authorization: Bearer`
// (needed off loopback; an `agent` token may read the inbox). They resolve
// as bin/inbox and bin/review-request resolve them: an empty value is
// unset, a trailing slash is dropped, and a URL that is not http(s) is
// refused (so is one with a query or fragment). Both are this script's
// variables, not the server's.

import { spawn } from "node:child_process";
import path from "node:path";
import { StringDecoder } from "node:string_decoder";
import { fileURLToPath } from "node:url";
import {
  buildPrompt,
  checkApiTrust,
  claudeArgs,
  FETCH_TIMEOUT_MS,
  parseInboxResponse,
  parseWatchArgs,
  planTick,
  readBodyCapped,
  remoteWarning,
  resolveApi,
  sanitizeForLog,
  staleLogLines,
  stripTerminalControls,
  takeRun,
  WATCH_USAGE,
  WATCHED_STATUSES,
} from "./inbox-watch-lib.mjs";

const options = parseWatchArgs(process.argv.slice(2));
if ("help" in options) {
  console.log(WATCH_USAGE);
  process.exit(0);
}
if ("error" in options) {
  console.error(`inbox-watch: ${options.error}\n${WATCH_USAGE}`);
  process.exit(2);
}

const resolved = resolveApi(process.env);
if ("error" in resolved) {
  console.error(`inbox-watch: ${resolved.error}`);
  process.exit(2);
}
const API = resolved.api;
const trust = checkApiTrust(API, { allowRemote: options.allowRemote });
if ("error" in trust) {
  console.error(`inbox-watch: ${trust.error}`);
  process.exit(2);
}
const REMOTE = trust.remote;

const AUTH = process.env.BREAKDOWN_TOKEN ? { authorization: `Bearer ${process.env.BREAKDOWN_TOKEN}` } : {};
const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

if (REMOTE) console.error(remoteWarning(API, REPO, options.maxAge, { hasToken: Boolean(process.env.BREAKDOWN_TOKEN) }));

function log(message) {
  console.log(`[${new Date().toLocaleTimeString()}] ${message}`);
}

async function query(statuses) {
  const url = `${API}/trpc/inbox?input=${encodeURIComponent(JSON.stringify({ statuses }))}`;
  const res = await fetch(url, { headers: AUTH, redirect: "error", signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
  const text = await readBodyCapped(res);
  let body;
  try {
    body = JSON.parse(text);
  } catch {
    throw new Error(`HTTP ${res.status}, not JSON`);
  }
  if (!res.ok || body?.error) throw new Error(typeof body?.error?.message === "string" ? body.error.message : `HTTP ${res.status}`);
  const parsed = parseInboxResponse(body);
  if ("error" in parsed) throw new Error(parsed.error);
  if (parsed.dropped > 0) log(`dropped ${parsed.dropped} malformed inbox entr${parsed.dropped === 1 ? "y" : "ies"}`);
  return parsed.items;
}

/** Copies a child's output stream to ours with terminal controls removed (stripTerminalControls). */
function copyStripped(from, to) {
  const decoder = new StringDecoder("utf8");
  from.on("data", (chunk) => to.write(stripTerminalControls(decoder.write(chunk))));
  from.on("end", () => to.write(stripTerminalControls(decoder.end())));
}

function runClaude(args) {
  return new Promise((resolve) => {
    const child = spawn("claude", args, { cwd: REPO, stdio: ["ignore", "pipe", "pipe"] });
    copyStripped(child.stdout, process.stdout);
    copyStripped(child.stderr, process.stderr);
    child.on("error", (err) => {
      log(`could not start claude: ${err.message}`);
      resolve(1);
    });
    child.on("close", (code) => resolve(code ?? 1));
  });
}

// Tried keys, replaced each tick by planTick's (see there): an item is tried
// once per version, so one the run left untouched (a connector failed, say)
// isn't retried until something changes it, and a stale one is logged once.
let tried = new Set();
// When each claude run started, for --max-runs-per-hour.
let runStarts = [];

async function tick() {
  let items;
  try {
    items = await query(WATCHED_STATUSES);
  } catch (err) {
    const reason = sanitizeForLog(err instanceof Error ? err.message : String(err));
    log(`can't read the inbox (${reason})${REMOTE ? "" : "; is `pnpm dev` running?"}`);
    return;
  }
  const plan = planTick(items, { tried, now: Date.now(), maxAgeMs: options.maxAgeMs, maxAge: options.maxAge });
  tried = plan.tried;
  for (const line of staleLogLines(plan.stale)) log(line);
  for (const { status, ids } of plan.batches) {
    const more = plan.leftover[status] > 0 ? ` (+${plan.leftover[status]} next tick)` : "";
    log(`${ids.length} ${status}: ${ids.join(", ")}${more}`);
    if (options.dryRun) {
      log("dry run: not starting claude");
      continue;
    }
    const budget = takeRun(runStarts, Date.now(), options.maxRunsPerHour);
    runStarts = budget.starts;
    if (!budget.allowed) {
      console.error(
        `inbox-watch: RUN BUDGET HIT: ${options.maxRunsPerHour} claude runs started in the last hour (--max-runs-per-hour). Stopping the watcher; nothing more runs. Check the inbox for an item that keeps coming back, then restart.`,
      );
      process.exit(3);
    }
    const code = await runClaude(claudeArgs(buildPrompt(status, ids)));
    log(code === 0 ? `${status} run finished` : `${status} run exited ${code}`);
  }
}

log(`watching ${API} every ${options.intervalMs / 1000}s, max-age ${options.maxAge}, ${REMOTE ? "REMOTE" : "loopback"} (repo ${REPO})${options.dryRun ? " — dry run" : ""}`);
for (;;) {
  await tick();
  if (options.once) break;
  await new Promise((r) => setTimeout(r, options.intervalMs));
}
